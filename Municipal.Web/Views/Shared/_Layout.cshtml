<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Municipal Connect</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header><div class="nav-wrap">
    <a class="brand" asp-controller="Requests" asp-action="Report"><span class="brand-mark" aria-hidden="true">M</span>Municipal Connect</a>
    <nav aria-label="Main navigation">
        <a asp-controller="Requests" asp-action="Report">Report a Problem</a>
        <a asp-controller="Requests" asp-action="Track">Track a Request</a>
        @if (User.IsInRole("Administrator")) {
            <a asp-controller="Admin" asp-action="Index">Admin Requests</a>
            <form asp-controller="Account" asp-action="Logout" method="post"><button class="nav-button" type="submit">Log out</button></form>
        } else { <a asp-controller="Account" asp-action="Login">Admin Login</a> }
    </nav>
</div></header>
<main id="main" class="container">
    @if (TempData["Success"] is string success) { <div class="notice success" role="status">@success</div> }
    @if (TempData["Error"] is string error) { <div class="notice error" role="alert">@error</div> }
    @RenderBody()
</main>
<footer><div class="container"><strong>Municipal Connect</strong><span>SPM622 student prototype · Local reporting and tracking</span></div></footer>
<script src="~/js/site.js" asp-append-version="true" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
