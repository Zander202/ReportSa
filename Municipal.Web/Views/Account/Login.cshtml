@model LoginForm
@{
    ViewData["Title"] = "Admin Login";
}

<section class="panel narrow">
    <p class="eyebrow">Municipal administration</p>
    <h1>Admin login</h1>
    <p class="muted" style="margin-bottom: 24px;">Use the administrator account configured for this local system.</p>

    <form asp-action="Login" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>

        <label asp-for="Email"></label>
        <input asp-for="Email" type="email" autocomplete="username" placeholder="admin@municipal.gov.za" />
        <span asp-validation-for="Email" class="validation"></span>

        <label asp-for="Password"></label>
        <input asp-for="Password" type="password" autocomplete="current-password" placeholder="••••••••" />
        <span asp-validation-for="Password" class="validation"></span>

        <button class="button" type="submit" style="width: 100%; margin-top: 24px; text-align: center;">Log in</button>
    </form>
</section>