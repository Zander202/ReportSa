@{
    ViewData["Title"] = "Create Administrator";
}

<a class="back-link" asp-action="Index">
    <i data-lucide="arrow-left" aria-hidden="true"></i> All requests
</a>

<section class="panel narrow">
    <div class="page-symbol">
        <i data-lucide="user-plus" aria-hidden="true"></i>
    </div>
    <p class="eyebrow">Municipal administration</p>
    <h1>Create administrator</h1>
    <p class="lead">Add a new administrator account for this system.</p>

    <form asp-action="CreateUser" method="post" class="create-user-form">

        <div asp-validation-summary="All" class="validation" role="alert"></div>

        <label for="email">Email address</label>
        <input type="email"
               id="email"
               name="email"
               placeholder="admin@municipal.gov.za"
               autocomplete="username"
               required />

        <label for="password">Password</label>
        <input type="password"
               id="password"
               name="password"
               placeholder="Minimum 12 characters"
               autocomplete="new-password"
               required />
        <span class="hint">Password must be at least 12 characters.</span>

        <div class="submit-row" style="padding-top:28px">
            <a class="button secondary" asp-action="Index">Cancel</a>
            <button type="submit" class="button">
                <i data-lucide="user-check" aria-hidden="true"></i>
                <span>Create account</span>
            </button>
        </div>

    </form>
</section>
