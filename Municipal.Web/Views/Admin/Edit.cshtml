@model ProblemRequest
@{ ViewData["Title"] = "Manage Request"; }
<a class="back-link" asp-action="Index">← All requests</a><section class="panel narrow"><p class="eyebrow">Manage request</p><h1>@Labels.CategoryName(Model.Category)</h1><p class="reference">@Model.ReferenceCode</p>
<dl class="details"><div><dt>Municipality</dt><dd>@(string.IsNullOrWhiteSpace(Model.MunicipalityName) ? "Not recorded" : Model.MunicipalityName)</dd></div><div><dt>Location</dt><dd>@Model.Location</dd></div><div><dt>Reported</dt><dd>@Model.ReportedAt.ToOffset(TimeSpan.FromHours(2)).ToString("dd MMM yyyy, HH:mm") SAST</dd></div><div><dt>Resident email</dt><dd>@Model.ResidentEmail</dd></div></dl><p class="description">@(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)</p>
<partial name="_PhotoGallery" model="Model" />
@if (Model.ResidentReview == ResidentReview.NotFixed) { <p class="notice error">The resident reported this problem is still not fixed.</p> }
<form asp-action="Update" method="post" enctype="multipart/form-data"><input type="hidden" name="Id" value="@Model.Id" /><input type="hidden" name="RowVersion" value="@Convert.ToBase64String(Model.RowVersion)" />
<label for="Priority">Priority</label><select id="Priority" name="Priority">@foreach (var p in Enum.GetValues<Priority>()) { <option value="@((int)p)" selected="@(Model.Priority == p)">@p</option> }</select><p class="hint">Priority describes urgency and does not change progress.</p>
<label for="AssignedRole">Assigned role</label><input id="AssignedRole" name="AssignedRole" maxlength="120" value="@Model.AssignedRole" />
<label for="AssignedPerson">Assigned person</label><input id="AssignedPerson" name="AssignedPerson" maxlength="120" value="@Municipal.Web.Services.AssignmentService.PersonName(Model.AssignedPerson)" />
<label for="EstimatedCompletionLocal">Estimated completion (SAST)</label><input id="EstimatedCompletionLocal" name="EstimatedCompletionLocal" type="datetime-local" value="@Model.EstimatedCompletionAt?.ToOffset(TimeSpan.FromHours(2)).ToString("yyyy-MM-ddTHH:mm")" />
<label for="Status">Status</label><select id="Status" name="Status"><option value="@((int)Model.Status)">@Labels.Status(Model.Status) (current)</option>@if (Model.Status != RequestStatus.Closed) { <option value="@((int)Model.Status+1)">@Labels.Status((RequestStatus)((int)Model.Status+1))</option> }</select>
<label for="ProgressNote">Progress update</label><textarea id="ProgressNote" name="ProgressNote" maxlength="1000" rows="3"></textarea>
<label for="ResolutionNotes">Repair details</label><textarea id="ResolutionNotes" name="ResolutionNotes" maxlength="1000" rows="3">@Model.ResolutionNotes</textarea>
<label for="ResolutionPhotos">Progress and repair photos</label><p class="hint">Add photos at any stage without marking the report resolved. Up to three photos in total, each 5 MB or smaller (JPEG, PNG or WebP).</p><input id="ResolutionPhotos" name="ResolutionPhotos" type="file" accept="image/jpeg,image/png,image/webp" multiple data-photo-input /><div class="photo-preview" data-photo-preview aria-live="polite"></div>
<div class="review-actions"><button class="button secondary" type="submit"><i data-lucide="save" aria-hidden="true"></i><span>Save changes</span></button>@if (Model.Status != RequestStatus.Closed) { <button class="button" type="submit" name="CloseTicket" value="true"><i data-lucide="circle-check" aria-hidden="true"></i><span>Close ticket and email reporter</span></button> }</div></form></section>
