@model ReportForm
@inject Municipal.Web.Services.MunicipalityDirectory Municipalities
@{
    ViewData["Title"] = "Report a Problem";
    var icons = new Dictionary<Category, string>
    {
        [Category.Pothole] = "🕳️",
        [Category.PowerOutage] = "⚡",
        [Category.BrokenStreetlight] = "💡",
        [Category.WaterLeak] = "💧",
        [Category.BlockedDrain] = "🌊",
        [Category.IllegalDumping] = "🗑️",
        [Category.Other] = "📋"
    };
}

<section class="hero reveal">
    <div>
        <p class="eyebrow">A better neighbourhood starts here</p>
        <h1>Report a local problem.</h1>
        <p class="lead">Tell us what needs attention. Keep your reference code to follow the request as it moves through the municipal workflow.</p>
        <div class="stats">
            <span class="stat">✔ No account needed</span>
            <span class="stat">Email confirmation</span>
            <span class="stat">🔎 Live tracking</span>
        </div>
    </div>
    <div class="hero-art" aria-hidden="true">
        <svg viewBox="0 0 900 600"><use href="#sa-flag" /></svg>
    </div>
</section>

<div class="two-column">
    <section class="intro reveal">
        <div class="info-card">
            <h2>How it works</h2>
            <ol class="how">
                <li>Describe the problem and its location.</li>
                <li>Save your unique reference code.</li>
                <li>Track status updates whenever you need.</li>
            </ol>
        </div>
        <p class="muted">No resident account required. This student prototype does not provide emergency assistance. In an emergency call <strong>10111</strong>, <strong>10177</strong> or <strong>112</strong>.</p>
    </section>

    <section class="panel reveal">
        <h2>Problem details</h2>

        <form asp-action="Report" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>

            <label>What kind of problem?</label>
            <div class="tiles" role="group" aria-label="Quick category picker">
                @foreach (var c in Enum.GetValues<Category>())
                {
                    <button type="button" class="tile" data-category="@((int)c)">
                        <span class="tile-icon" aria-hidden="true">@icons[c]</span>
                        <span>@Labels.CategoryName(c)</span>
                    </button>
                }

            </div>

            <label asp-for="Category"></label>
            <select asp-for="Category" asp-items="Html.GetEnumSelectList<Category>()">
                <option value="">Select a category</option>
            </select>
            <span asp-validation-for="Category" class="validation"></span>

            <label asp-for="MunicipalityCode"></label>
            <select asp-for="MunicipalityCode" required>
                <option value="">Select your municipality</option>
                @foreach (var province in Municipalities.All.GroupBy(x => x.Province))
                {
                    <optgroup label="@province.Key">
                        @foreach (var municipality in province)
                        {
                            <option value="@municipality.Code">@municipality.Label</option>
                        }
                    </optgroup>
                }
            </select>
            <span asp-validation-for="MunicipalityCode" class="validation"></span>

            <label asp-for="Location"></label>
            <input asp-for="Location" maxlength="200" placeholder="e.g. 24 Oak Street, near the library" />
            <span asp-validation-for="Location" class="validation"></span>
            <input asp-for="Latitude" type="hidden" />
            <input asp-for="Longitude" type="hidden" />
            <button type="button" id="locate-button" class="button secondary">Use my location</button>
            <p id="location-feedback" class="hint" role="status" aria-live="polite"></p>

            <label asp-for="ResidentEmail"></label>
            <input asp-for="ResidentEmail" type="email" maxlength="254" placeholder="e.g. thabo@example.co.za" autocomplete="email" required />
            <span asp-validation-for="ResidentEmail" class="validation"></span>

            <label asp-for="Description"></label>
            <textarea asp-for="Description" rows="5" maxlength="1000" placeholder="Add details that will help the municipality understand the issue."></textarea>
            <div class="counter"><span id="char-count">0</span> / 1000</div>
            <span asp-validation-for="Description" class="validation"></span>
            <p class="hint">Please avoid personal or sensitive information.</p>

            <button type="submit" class="button gold" style="width:100%;margin-top:24px">Submit problem</button>

        </form>
    </section>
</div>
